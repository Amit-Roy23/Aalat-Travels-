# ── Required ────────────────────────────────────────────────
# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/aalat_travels?retryWrites=true&w=majority
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# ── AI replies (optional – without it the built-in demo AI engine is used) ──
ANTHROPIC_API_KEY=

# ── WhatsApp Business Cloud API (optional – needed for real WhatsApp) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-verify-string
WHATSAPP_APP_SECRET=

# ── Meta Lead Ads (optional – auto-capture Facebook/Instagram lead forms) ──
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=choose-any-verify-string
